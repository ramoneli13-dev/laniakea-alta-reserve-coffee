# Copy this file to .env.local when you are ready to connect real services.

# Contact form destination. Example: hello@laniakeacoffee.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Stripe keys for the future checkout integration.
# Do not publish real secret keys in GitHub.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional business details.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_LOCATION=California, United States
