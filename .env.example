# Copy this file to .env.local when you are ready to connect real services.

# Contact form destination.
CONTACT_TO_EMAIL=ramoneli13@gmail.com

# Resend email service for the secure contact API route.
# Do not publish real secret keys in GitHub.
RESEND_API_KEY=

# Use a sender from a domain verified in Resend, such as contact@laniakeacoffeee.com.
# Temporary testing fallback: onboarding@resend.dev
RESEND_FROM_EMAIL=contact@laniakeacoffeee.com

# Optional public contact email shown by the site.
NEXT_PUBLIC_CONTACT_EMAIL=ramoneli13@gmail.com

# Stripe keys for the future checkout integration.
# Do not publish real secret keys in GitHub.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public URL used by Stripe to return customers after payment.
# Local example: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional business details.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_LOCATION=California, United States

# Coinbase Advanced API balances endpoint.
# Use an Ed25519 Coinbase API key. Do not publish real secrets in GitHub.
COINBASE_ADVANCED_API_KEY=
COINBASE_ADVANCED_PRIVATE_KEY=

# Optional bearer token required by /api/coinbase/balances when set.
COINBASE_BALANCES_ACCESS_TOKEN=
